# ARBO OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your Supabase project credentials.

# Public Supabase URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (Safe to expose in browser bundle with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# IMPORTANT: NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend code or files prefixed with VITE_
